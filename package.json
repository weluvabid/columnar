{
  "name": "@columnar/core",
  "version": "0.1.0",
  "description": "A typed-array-native, allocation-conscious data processing engine for JavaScript and TypeScript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/weluvabid/columnar.git"
  },
  "homepage": "https://github.com/weluvabid/columnar#readme",
  "bugs": {
    "url": "https://github.com/weluvabid/columnar/issues"
  },
  "keywords": [
    "columnar",
    "typed-arrays",
    "data-processing",
    "analytics",
    "streaming",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node --expose-gc --import tsx benchmarks/run.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "precommit": "pnpm lint && pnpm format:check && pnpm test",
    "prepare": "sh ./scripts/install-hooks.sh",
    "prepack": "pnpm build",
    "bench:advanced": "node --expose-gc --import tsx benchmarks/advanced.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.3.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  }
}
